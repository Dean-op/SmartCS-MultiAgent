# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_HOST_PORT=8000
HEALTHCHECK_TIMEOUT_SECONDS=3

# PostgreSQL
# Local development values only. Replace passwords before shared or production use.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=ecommerce_agent
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6379

# Milvus Standalone
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_HOST_PORT=19530
MILVUS_MANAGEMENT_PORT=9091
MILVUS_MANAGEMENT_HOST_PORT=9091

# MinIO used by Milvus
MINIO_ROOT_USER=ecommerce_minio
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
