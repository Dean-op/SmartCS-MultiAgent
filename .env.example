# Application
APP_ENV=development
LOG_LEVEL=INFO
OTEL_CONSOLE_EXPORTER=true
LLM_INPUT_PRICE_PER_MILLION_CNY=3.00
LLM_OUTPUT_PRICE_PER_MILLION_CNY=12.00
API_HOST=0.0.0.0
API_PORT=8000
API_HOST_PORT=8000
HEALTHCHECK_TIMEOUT_SECONDS=3

# Authentication
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refund rules
REFUND_WINDOW_DAYS=30
REFUND_AUTO_APPROVE_MAX_AMOUNT=100.00
REFUND_RECENT_COUNT_DAYS=30
REFUND_RECENT_COUNT_LIMIT=2

# PostgreSQL
# Local development values only. Replace passwords before shared or production use.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=ecommerce_agent
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6379

# Milvus Standalone
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_HOST_PORT=19530
MILVUS_MANAGEMENT_PORT=9091
MILVUS_MANAGEMENT_HOST_PORT=9091

# MinIO used by Milvus
MINIO_ROOT_USER=ecommerce_minio
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Alibaba Cloud Model Studio / Bailian
# Keep the API key empty in version control. The Base URL must match the key region.
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-27b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_COMPLETION_TOKENS=800

# Dense RAG
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
KNOWLEDGE_COLLECTION=ecommerce_knowledge
KNOWLEDGE_TOP_K=3
BAILIAN_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank
HYBRID_CANDIDATE_K=10
RRF_K=60
RERANK_MIN_SCORE=0.2
